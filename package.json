{
  "name": "ailoopchecker",
  "version": "1.0.1",
  "description": "geatsc ile native C++ ikili dosyaya derlenen AI medya (görsel/ürün, video, ses, kod, metin) ve Proje AI-Loop adli tespit CLI uygulaması",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "bin": {
    "ailoopchecker": "./bin/ailoopchecker.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "start": "bash scripts/run-cli.sh",
    "start:node": "node src/cli.ts",
    "build": "node scripts/build-native.mjs",
    "build:debug": "node scripts/build-native.mjs --debug",
    "build:npm": "node scripts/build-npm.mjs",
    "prepublishOnly": "npm run build:npm && npm test",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node src/cli.ts --self-test",
    "test:native": "./dist/ailoopchecker --self-test"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
