{
  "name": "ailoopchecker",
  "version": "1.0.0",
  "description": "geatsc ile native C++ ikili dosyaya derlenen AI medya (görsel/ürün, video, ses, metin) adli tespit CLI uygulaması",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ailoopchecker": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "node scripts/build-native.mjs",
    "build:debug": "node scripts/build-native.mjs --debug",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node src/cli.ts --self-test",
    "test:native": "./dist/ailoopchecker --self-test"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
